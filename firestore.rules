rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Kapak ve not fotoğrafları: data URL biçimi + boyut sınırı.
    // Not: Firestore kuralları dizi elemanlarını tek tek dolaşamaz; bu yüzden
    // kitaplık dokümanının `books` içeriği istemci tarafında doğrulanır.
    function isImg(d, max) {
      return d is string
        && d.size() <= max
        && d.matches('data:image/(jpeg|png|webp);base64,.*');
    }

    function hasKey(m, k) {
      return m.keys().hasAny([k]);
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is int;
      allow update: if false;
      allow delete: if owner(uid) && verified();

      match /library/{documentId} {
        allow read: if owner(uid) && verified() && documentId == 'main';
        allow create, update: if owner(uid)
          && verified()
          && documentId == 'main'
          && request.resource.data.keys().hasOnly(['books', 'set'])
          && request.resource.data.keys().hasAll(['books', 'set'])
          && request.resource.data.books is list
          && request.resource.data.books.size() <= 500
          && request.resource.data.set is map
          && request.resource.data.set.keys().hasOnly(['th', 'fs', 'sh', 'sa', 'lh', 'un'])
          && (!hasKey(request.resource.data.set, 'th')
              || (request.resource.data.set.th is string && request.resource.data.set.th.size() <= 10))
          && (!hasKey(request.resource.data.set, 'fs')
              || (request.resource.data.set.fs is string && request.resource.data.set.fs.size() <= 6))
          && (!hasKey(request.resource.data.set, 'sh')
              || (request.resource.data.set.sh is list && request.resource.data.set.sh.size() <= 20))
          && (!hasKey(request.resource.data.set, 'sa')
              || (request.resource.data.set.sa is map && request.resource.data.set.sa.size() <= 500))
          && (!hasKey(request.resource.data.set, 'lh')
              || (request.resource.data.set.lh is list && request.resource.data.set.lh.size() <= 500))
          && (!hasKey(request.resource.data.set, 'un')
              || (request.resource.data.set.un is string && request.resource.data.set.un.size() <= 30));
        allow delete: if owner(uid) && verified() && documentId == 'main';
      }

      match /covers/{coverId} {
        allow read: if owner(uid) && verified();
        allow create, update: if owner(uid)
          && verified()
          && coverId.matches('[A-Za-z0-9_-]{1,60}')
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.keys().hasAll(['d'])
          && isImg(request.resource.data.d, 500000);
        allow delete: if owner(uid) && verified();
      }

      match /notePhotos/{photoId} {
        allow read: if owner(uid) && verified();
        allow create, update: if owner(uid)
          && verified()
          && photoId.matches('[A-Za-z0-9_-]{1,64}')
          && request.resource.data.keys().hasOnly(['b', 'd', 't'])
          && request.resource.data.keys().hasAll(['b', 'd', 't'])
          && request.resource.data.b is string
          && request.resource.data.b.size() <= 100
          && request.resource.data.b.matches('[A-Za-z0-9_-]{1,60}')
          && isImg(request.resource.data.d, 700000)
          && request.resource.data.t is int;
        allow delete: if owner(uid) && verified();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
