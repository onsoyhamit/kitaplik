rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUsernameKey(usernameKey) {
      return usernameKey is string
        && usernameKey.matches('^[a-z0-9._-]{3,20}$');
    }

    match /usernames/{usernameKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsernameKey(usernameKey)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey == usernameKey;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.keys().hasOnly(['uid'])
        && resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey != usernameKey
        && validUsernameKey(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey)
        && existsAfter(/databases/$(database)/documents/usernames/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey))
        && getAfter(/databases/$(database)/documents/usernames/$(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey)).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameKey', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'usernameKey', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && validUsernameKey(request.resource.data.username)
        && request.resource.data.usernameKey == request.resource.data.username
        && validUsernameKey(request.resource.data.usernameKey)
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      allow update: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameKey', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'usernameKey', 'createdAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && validUsernameKey(request.resource.data.username)
        && request.resource.data.usernameKey == request.resource.data.username
        && validUsernameKey(request.resource.data.usernameKey)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'usernameKey'])
        && exists(/databases/$(database)/documents/usernames/$(resource.data.usernameKey))
        && get(/databases/$(database)/documents/usernames/$(resource.data.usernameKey)).data.uid == uid
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      allow delete: if false;

      match /library/{documentId} {
        allow read: if owner(uid) && verified() && documentId == 'main';
        allow create, update: if owner(uid)
          && verified()
          && documentId == 'main'
          && request.resource.data.keys().hasOnly(['books', 'set'])
          && request.resource.data.keys().hasAll(['books', 'set'])
          && request.resource.data.books is list
          && request.resource.data.books.size() <= 500
          && request.resource.data.set is map;
        allow delete: if false;
      }

      match /covers/{coverId} {
        allow read: if owner(uid) && verified();
        allow create, update: if owner(uid)
          && verified()
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string
          && request.resource.data.d.size() <= 900000;
        allow delete: if owner(uid) && verified();
      }

      match /notePhotos/{photoId} {
        allow read: if owner(uid) && verified();
        allow create, update: if owner(uid)
          && verified()
          && request.resource.data.keys().hasOnly(['b', 'd', 't'])
          && request.resource.data.keys().hasAll(['b', 'd', 't'])
          && request.resource.data.b is string
          && request.resource.data.b.size() <= 100
          && request.resource.data.d is string
          && request.resource.data.d.size() <= 900000
          && request.resource.data.t is int;
        allow delete: if owner(uid) && verified();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
