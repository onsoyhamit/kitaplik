rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is int;
      allow update: if false;
      allow delete: if owner(uid) && verified();

      match /library/{documentId} {
        allow read: if owner(uid) && verified() && documentId == 'main';
        allow create, update: if owner(uid)
          && verified()
          && documentId == 'main'
          && request.resource.data.keys().hasOnly(['books', 'set'])
          && request.resource.data.keys().hasAll(['books', 'set'])
          && request.resource.data.books is list
          && request.resource.data.books.size() <= 500
          && request.resource.data.set is map
          && request.resource.data.set.keys().hasOnly(['th', 'fs', 'sh', 'sa', 'lh', 'un']);
        allow delete: if owner(uid) && verified() && documentId == 'main';
      }

      match /covers/{coverId} {
        allow read: if owner(uid) && verified();
        allow create, update: if owner(uid)
          && verified()
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is string
          && request.resource.data.d.size() <= 900000;
        allow delete: if owner(uid) && verified();
      }

      match /notePhotos/{photoId} {
        allow read: if owner(uid) && verified();
        allow create, update: if owner(uid)
          && verified()
          && request.resource.data.keys().hasOnly(['b', 'd', 't'])
          && request.resource.data.keys().hasAll(['b', 'd', 't'])
          && request.resource.data.b is string
          && request.resource.data.b.size() <= 100
          && request.resource.data.d is string
          && request.resource.data.d.size() <= 900000
          && request.resource.data.t is int;
        allow delete: if owner(uid) && verified();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
